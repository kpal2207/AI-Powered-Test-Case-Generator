# Copy this file to .env and add your API key. Never commit .env.
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-6-astra

# Optional: override the FastAPI address used by the Streamlit UI.
API_BASE_URL=http://127.0.0.1:8000

# Optional: change the already-built local Docker runner image name.
TEST_RUNNER_IMAGE=ai-test-case-generator-runner:local
